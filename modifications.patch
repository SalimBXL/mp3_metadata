+        let mut body = frame(b"TIT2", &text("Titre"));
+        body.extend(frame(b"TPE1", &text("Artiste")));
+        body.extend(frame(b"TALB", &text("Album")));
+        body.extend(frame(b"TYER", &text("1999")));
+        let mut comm = vec![3];
