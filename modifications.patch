+    for (index, release) in response
+        .releases
+        .iter()
+        .take(RELEASE_LOOKUP_CANDIDATES)
+        .enumerate()
+    {
+        if index > 0 {
+            std::thread::sleep(REQUEST_INTERVAL);
+        }
