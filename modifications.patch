+    fn id3v1_bytes(title: &str) -> [u8; 128] {
+        let mut tag = [0u8; 128];
+        tag[0..3].copy_from_slice(b"TAG");
+        let title_bytes = title.as_bytes();
+        tag[3..3 + title_bytes.len()].copy_from_slice(title_bytes);
