+    let response: ReleaseSearchResponse = ureq::get(MUSICBRAINZ_RELEASE_URL)
+        .set("User-Agent", USER_AGENT)
+        .query("query", &query)
+        .query("fmt", "json")
+        .query("limit", &RELEASE_LOOKUP_CANDIDATES.to_string())
+        .call()?
+        .into_json()?;
