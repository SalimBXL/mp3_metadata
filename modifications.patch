+            flags: 0x1, // seulement le bit "nombre de frames"
+            frame_count: 1234,
+            total_bytes: None,
+        });
+
+        let info = parse_xing_stream_info(&frame, MpegVersion::V1, ChannelMode::Stereo).unwrap();
+
+        assert_eq!(info.frame_count, 1234);
+        assert_eq!(info.total_bytes, None);
+    }
